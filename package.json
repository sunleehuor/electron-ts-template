{
  "name": "react-desktop-ts",
  "private": true,
  "version": "0.0.0",
  "lee-tr": {
    "configPath": "src/data/config/i18n/config.json"
  },
  "author": {
    "name": "react.electron",
    "email": "react.electron@mail.com"
  },
  "main": "dist/electron/src/main.js",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:all": "concurrently \"npm run dev\" \"npm run electron:dev\"",
    "build": "npm run electron:build && vite build",
    "electron:build": "tsup --onSuccess \"sh ./scripts/preElectronBuild.sh\"",
    "electron:ts": "tsup --watch --onSuccess \"sh ./scripts/preElectronBuild.sh\"",
    "electron:run": "wait-on dist/electron/src/main.js && nodemon --watch dist/electron --exec electron dist/electron/src/main.js",
    "electron:dev": "concurrently \"npm run electron:ts\" \"npm run electron:run\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "t": "lee-tr t",
    "tr": "node scripts/translateRefactor.js",
    "window-package": "electron-builder --win",
    "mac-package": "electron-builder --mac",
    "linux-package": "electron-builder --linux"
  },
  "build": {
    "appId": "react.electron",
    "productName": "test",
    "executableName": "myapp",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*.node"
    ],
    "files": [
      "dist/electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.electron",
        "to": ".env"
      },
      {
        "from": "dist/renderer",
        "to": "renderer"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "differentialPackage": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/logo.png"
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.13.2",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "i18next": "^25.7.4",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "node-machine-id": "^1.1.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.1",
    "react-router": "^7.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lee-tr-cli": "^1.0.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
}
